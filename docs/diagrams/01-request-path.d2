# =============================================================================
# How an inference request reaches a model
# =============================================================================
# Render:  d2 --sketch --theme 0 --dark-theme 200 01-request-path.d2 01-request-path.svg
#
# The point of this diagram: the caller's credential never reaches the model.
# Authorino validates it and strips the Authorization header before the request
# is forwarded, so a compromised model backend cannot harvest OpenShift tokens.

vars: {
  d2-config: {
    layout-engine: dagre
    sketch: true
  }
}

direction: down

classes: {
  platform: {
    style: {
      fill: "#f2f7ff"
      stroke: "#3b5bdb"
      stroke-width: 2
    }
  }
  chart: {
    style: {
      fill: "#f4fce3"
      stroke: "#5c940d"
      stroke-width: 2
    }
  }
  reject: {
    style: {
      fill: "#fff5f5"
      stroke: "#c92a2a"
      stroke-dash: 3
    }
  }
  note: {
    shape: text
    style: {
      font-size: 13
      italic: true
    }
  }
}

client: Client application {
  shape: person
  style.fill: "#fff9db"
}

gw: "maas-default-gateway\n(Gateway API · openshift-ingress)" {
  class: platform
}

authorino: "Authorino\nAuthPolicy" {
  class: platform
}

maasapi: "maas-api\nvalidates key · resolves subscription" {
  class: platform
}

limitador: "Limitador\nTokenRateLimitPolicy" {
  class: platform
}

backend: Model backend {
  class: chart

  vllm: "LLMInferenceService\nvLLM pod" {
    class: chart
  }
  external: "ExternalModel\nServiceEntry -> provider" {
    class: chart
  }
}

denied: "401 / 403\nnot authenticated or not entitled" {
  class: reject
}

throttled: "429\nquota exhausted" {
  class: reject
}

client -> gw: "Bearer <OpenShift token\nor MaaS API key>"
gw -> authorino: "1 · who is calling?"
authorino <-> maasapi: callback
authorino -> denied: no matching MaaSAuthPolicy
authorino -> limitador: "2 · strips Authorization header" {
  style.bold: true
  style.stroke: "#2b8a3e"
}
limitador -> throttled: over MaaSSubscription limit
limitador -> backend: "3 · forwards, credential removed"

explain: |md
  ### Both halves must be in place

  - **MaaSAuthPolicy** decides *who* may call. Without one, every request is denied.
  - **MaaSSubscription** decides *how many tokens*. Without one there is no quota
    to check, and the model never reaches `phase=Ready`.

  Header stripping (step 2) needs Kuadrant **1.4.2+** / RHCL 1.3+. On older
  versions the caller's token is forwarded to the model pod, where a compromised
  backend could harvest it.
| {
  near: bottom-center
  style: {
    font-size: 15
    fill: "#fffaf0"
    stroke: "#e8590c"
  }
}
